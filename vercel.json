{
  "buildCommand": "npm run build:verify",
  "outputDirectory": "dist",
  "framework": "vite",
  "env": {
    "VITE_BACKEND_BASE_URL": "https://api.evzone.app/api/v1",
    "VITE_SOCKET_BASE_URL": "https://api.evzone.app",
    "VITE_BACKEND_ENABLED": "true",
    "VITE_USE_BACKEND": "true"
  },
  "version": 2,
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
